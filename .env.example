# Скопируй этот файл в .env и впиши свои значения.
# Файл .env никому не отправляй и не загружай на GitHub.

# Провайдер ИИ: groq (бесплатно, для разработки) или openrouter (платно, для публичной версии).
# Модель одна и та же — openai/gpt-oss-20b (задана в config.py по итогам тестов).
LLM_PROVIDER=groq

# Ключ выбранного провайдера
GROQ_API_KEY=
OPENROUTER_API_KEY=

# Сколько запросов к ИИ отправлять одновременно (бесплатный Groq: 1, OpenRouter: 3-4)
MAX_PARALLEL=1

# Почта для OpenAlex (по желанию, так рекомендует OpenAlex)
OPENALEX_EMAIL=
# Ключ OpenAlex (если OpenAlex его потребует; иначе оставь пустым)
OPENALEX_API_KEY=

# Тестовый режим и админка (придумай свой пароль)
ADMIN_PASSWORD=change-me
SECRET_KEY=change-me-too

# 1 — режим разработки (подробные ошибки), 0 — для публичного сайта
FLASK_DEBUG=1
